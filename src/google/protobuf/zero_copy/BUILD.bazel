# Zero-copy parsing library for Protocol Buffers.
# This library provides zero-copy access to string and bytes fields
# in parsed messages.

load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//build_defs:cpp_opts.bzl", "COPTS")

package(
    default_visibility = ["//visibility:public"],
)

cc_library(
    name = "parse_buffer",
    srcs = ["parse_buffer.cc"],
    hdrs = ["parse_buffer.h"],
    copts = COPTS,
    strip_include_prefix = "/src",
    deps = [
        "//src/google/protobuf:port",
        "@abseil-cpp//absl/log:absl_log",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/types:span",
    ],
)

cc_library(
    name = "zero_copy_string",
    hdrs = ["zero_copy_string.h"],
    copts = COPTS,
    strip_include_prefix = "/src",
    deps = [
        ":parse_buffer",
        "//src/google/protobuf:port",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/types:span",
    ],
)

cc_library(
    name = "zero_copy_parser",
    hdrs = ["zero_copy_parser.h"],
    copts = COPTS,
    strip_include_prefix = "/src",
    deps = [
        ":parse_buffer",
        ":zero_copy_string",
        "//src/google/protobuf:message_lite",
        "//src/google/protobuf:port",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
    ],
)

cc_library(
    name = "zero_copy",
    hdrs = ["zero_copy.h"],
    copts = COPTS,
    strip_include_prefix = "/src",
    deps = [
        ":parse_buffer",
        ":zero_copy_parser",
        ":zero_copy_string",
    ],
)

cc_test(
    name = "zero_copy_test",
    srcs = ["zero_copy_test.cc"],
    copts = COPTS,
    deps = [
        ":zero_copy",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/types:span",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "zero_copy_benchmark_lib",
    testonly = 1,
    srcs = ["zero_copy_benchmark.cc"],
    copts = COPTS,
    deps = [
        ":zero_copy",
        "@abseil-cpp//absl/strings",
        "@google_benchmark//:benchmark",
    ],
)
